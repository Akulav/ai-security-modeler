# Copy to .env. This file holds secrets: keep it out of version control.

# HaveIBeenPwned API key, from https://haveibeenpwned.com/API/Key (paid subscription).
# Breach checks stay disabled until this is set.
HIBP_API_KEY=

# The app downloads and runs its own Ollama under llm/, on a free port.
# To use an Ollama you already run, set LLM_AUTO_SETUP=false and point OLLAMA_URL at it.
# Keep that server on your machine: it receives your graph.
LLM_AUTO_SETUP=true
# OLLAMA_URL=http://127.0.0.1:11434

# Model used until you pick another in the analysis panel. Needs tool support for web research.
OLLAMA_MODEL=hf.co/huihui-ai/Huihui-Qwen3.8-27B-abliterated-GGUF
OLLAMA_TIMEOUT_SECONDS=1800
# Raise this for very large graphs. Higher values use more memory and run slower.
OLLAMA_NUM_CTX=16384
